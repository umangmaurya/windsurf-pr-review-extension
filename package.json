{
  "name": "windsurf-pr-review-extension",
  "version": "1.0.0",
  "description": "Open PR review workflow in Windsurf directly from GitHub Enterprise PR pages",
  "scripts": {
    "build": "esbuild src/content.ts src/popup.ts --bundle --outdir=dist --format=iife --target=chrome100",
    "watch": "esbuild src/content.ts src/popup.ts --bundle --outdir=dist --format=iife --target=chrome100 --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "author": "Umang Maurya",
  "license": "MIT"
}
